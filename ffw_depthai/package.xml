<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ffw_depthai</name>
  <version>0.0.1</version>
  <description>DepthAI Core ROS 2 wrapper and example node</description>
  <maintainer email="lys@todo.todo">lys</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <!-- depthai is managed internally as a submodule and built locally -->
  <depend>nlohmann-json-dev</depend>
  <depend>fmt</depend>
  <depend>spdlog</depend>
  <depend>boost</depend>
  <depend>libusb-1.0-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>protobuf-dev</depend>
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
