<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    xm430_gripper macro
    Single-joint gripper driven by a Dynamixel XM430-W350 motor.
    Replaces the RH-P12-RN-A 4-bar linkage gripper on the FFW_SG2SMTM variant.

    Base link = axis marker (red=X, green=Y, blue=Z cylinders) like a standard ROS marker.
    Finger = orange cylinder sweeps from X axis (θ=0, gripping) to Z axis (θ=π/2, rest/open).

    Usage:
      <xacro:xm430_gripper parent="arm_r_link7" prefix="gripper_r_"
        origin_xyz="0.15 0 0" origin_rpy="0 0 0"/>
  -->
  <xacro:macro name="xm430_gripper" params="parent prefix origin_xyz origin_rpy">
    <!-- Robot-scope material definitions (Gazebo needs named materials) -->
    <material name="${prefix}grip_x_red">
      <color rgba="1 0 0 1"/>
    </material>
    <material name="${prefix}grip_y_green">
      <color rgba="0 1 0 1"/>
    </material>
    <material name="${prefix}grip_z_blue">
      <color rgba="0 0 1 1"/>
    </material>
    <material name="${prefix}grip_orange_finger">
      <color rgba="1 0.5 0 1"/>
    </material>

    <!-- Fixed base joint - motor housing attached to arm -->
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!-- Base link - axis marker (red=X, green=Y, blue=Z) -->
    <link name="${prefix}base_link">
      <!-- X axis - red, shifted +X by half length -->
      <visual>
        <origin xyz="0.075 0 0" rpy="0 -1.5708 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
        <material name="${prefix}grip_x_red"/>
      </visual>
      <!-- Y axis - green, shifted +Y by half length -->
      <visual>
        <origin xyz="0 0.075 0" rpy="-1.5708 0 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
        <material name="${prefix}grip_y_green"/>
      </visual>
      <!-- Z axis - blue, shifted +Z by half length -->
      <visual>
        <origin xyz="0 0 0.075" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
        <material name="${prefix}grip_z_blue"/>
      </visual>
      <!-- Collision - keep simple sphere -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.025"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.082"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Revolute joint - finger actuator rotates around Y axis -->
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}finger_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit velocity="9999.0" effort="9999.0" lower="0" upper="${pi/2}"/>
    </joint>

    <!-- Finger - cylinder sweeps from X axis (θ=0) to Z axis (θ=π/2) around -Y axis -->
    <link name="${prefix}finger_link">
      <visual>
        <origin xyz="0.075 0 0" rpy="0 -1.5708 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
        <material name="${prefix}grip_orange_finger"/>
      </visual>
      <collision>
        <origin xyz="0.075 0 0" rpy="0 -1.5708 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.075 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
