<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ffw_radio</name>
  <version>0.0.1</version>
  <description>RadioLink R16F Telemetry Dashboard</description>
  <maintainer email="analys@todo.todo">analys</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>joy</depend>
  <depend>joy_teleop</depend>
  <depend>ament_index_cpp</depend>
  <depend>ffw_collision_checker</depend>
  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
